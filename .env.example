# Every variable has a default a laptop can run with, so no .env is needed for the example:
#   uv run portfolio-optimizer run configs/example_buy.json --as-of 2026-08-28T00:00:00Z
# Copy this file to .env and run with `uv run --env-file .env ...` to change any of them.
PORTFOLIO_OPTIMIZER_OUTPUT_DIR=./out
PORTFOLIO_OPTIMIZER_DATA_ROOT=./examples/data
PORTFOLIO_OPTIMIZER_LOG_LEVEL=INFO
# Where the work runs. These are settings, not config, so a laptop run and a cluster run of the same
# config hash identically. `inline` (the default) runs every task in this process, one after another;
# the others provision a Dask cluster the run owns and tears down when it ends.
PORTFOLIO_OPTIMIZER_CLUSTER=inline           # inline | local | https://gateway (a Dask Gateway) | tcp://host:8786 | tls://host:8786
PORTFOLIO_OPTIMIZER_MIN_WORKERS=1            # provisioned before the load stage (local and gateway)
PORTFOLIO_OPTIMIZER_MAX_WORKERS=1            # scaled to after assembly
PORTFOLIO_OPTIMIZER_CLUSTER_TIMEOUT_S=120    # for the first worker to appear
# Optional:
#   PORTFOLIO_OPTIMIZER_STEP_PACKAGES=my_firm_quant,desk_tools   # the only packages a qualified step name may import from; unset, any importable module
#   PORTFOLIO_OPTIMIZER_WORKER_IMAGE=...      # required for a gateway: the image its pods run, normally this run's own
#   PORTFOLIO_OPTIMIZER_GATEWAY_PASSWORD=...  # required for a gateway: the password its simple authenticator accepts
#   PORTFOLIO_OPTIMIZER_GATEWAY_PROXY_ADDRESS=tls://host:8786   # where a gateway publishes scheduler traffic, when not its own host and port
