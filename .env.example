# Copy to .env and run with: uv run --env-file .env portfolio-optimizer run configs/example_run.json
# Every variable below is required; startup fails if one is missing or invalid.
PORTFOLIO_OPTIMIZER_OUTPUT_DIR=./out
PORTFOLIO_OPTIMIZER_DATA_ROOT=./examples/data
PORTFOLIO_OPTIMIZER_LOG_LEVEL=INFO
# The Dask cluster the run provisions for itself and tears down when it ends. These are settings, not
# config, so a laptop run and a cluster run of the same config hash identically.
PORTFOLIO_OPTIMIZER_CLUSTER=local            # local | kubernetes | auto (kubernetes inside a pod, local elsewhere) | tcp://host:8786 | tls://host:8786
PORTFOLIO_OPTIMIZER_MIN_WORKERS=1            # provisioned before the load stage
PORTFOLIO_OPTIMIZER_MAX_WORKERS=2            # scaled to after assembly
PORTFOLIO_OPTIMIZER_CLUSTER_TIMEOUT_S=120    # for the first worker to appear
# Optional:
#   PORTFOLIO_OPTIMIZER_WORKER_IMAGE=...      # required for kubernetes: the image worker pods run, normally this run's own
#   PORTFOLIO_OPTIMIZER_IMAGE_DIGEST=...      # set by the platform; recorded in every worker's fingerprint
